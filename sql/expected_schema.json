    },
    {
      "table_name": "users",
      "conname": "ck_users_display_name",
      "definition": "CHECK ((btrim((display_name)::text) <> ''::text))"
    },
    {
      "table_name": "users",
      "conname": "ck_users_login",
      "definition": "CHECK (((btrim((login)::text) <> ''::text) AND ((login)::text = lower(btrim((login)::text)))))"
    },
    {
      "table_name": "users",
      "conname": "ck_users_password_hash",
      "definition": "CHECK ((btrim(password_hash) <> ''::text))"
    },
    {
      "table_name": "users",
      "conname": "fk_users_role",
      "definition": "FOREIGN KEY (role_id) REFERENCES docsearch.roles(role_id) ON UPDATE RESTRICT ON DELETE RESTRICT"
    },
    {
      "table_name": "users",
