  "constraints": [
    {
      "table_name": "categories",
      "conname": "ck_categories_name",
      "definition": "CHECK ((btrim((name)::text) <> ''::text))"
    },
    {
      "table_name": "categories",
      "conname": "pk_categories",
      "definition": "PRIMARY KEY (category_id)"
    },
    {
      "table_name": "categories",
      "conname": "uq_categories_name",
      "definition": "UNIQUE (name)"
    },
    {
      "table_name": "chunk_embeddings",
      "conname": "ck_chunk_embeddings_nonzero",
      "definition": "CHECK ((vector_norm(embedding) > (0)::double precision))"
    },
    {
      "table_name": "chunk_embeddings",
      "conname": "fk_chunk_embeddings_chunk",
      "definition": "FOREIGN KEY (chunk_id) REFERENCES docsearch.document_chunks(chunk_id) ON UPDATE RESTRICT ON DELETE CASCADE"
    },
    {
      "table_name": "chunk_embeddings",
      "conname": "fk_chunk_embeddings_model",
      "definition": "FOREIGN KEY (model_id) REFERENCES docsearch.embedding_models(model_id) ON UPDATE RESTRICT ON DELETE RESTRICT"
    },
    {
      "table_name": "chunk_embeddings",
      "conname": "pk_chunk_embeddings",
      "definition": "PRIMARY KEY (chunk_id, model_id)"
    },
    {
      "table_name": "collection_access",
      "conname": "fk_collection_access_collection",
      "definition": "FOREIGN KEY (collection_id) REFERENCES docsearch.collections(collection_id) ON UPDATE RESTRICT ON DELETE CASCADE"
    },
    {
      "table_name": "collection_access",
      "conname": "fk_collection_access_user",
      "definition": "FOREIGN KEY (user_id) REFERENCES docsearch.users(user_id) ON UPDATE RESTRICT ON DELETE CASCADE"
    },
    {
      "table_name": "collection_access",
      "conname": "pk_collection_access",
      "definition": "PRIMARY KEY (user_id, collection_id)"
    },
    {
      "table_name": "collections",
      "conname": "ck_collections_name",
      "definition": "CHECK ((btrim((name)::text) <> ''::text))"
    },
    {
      "table_name": "collections",
      "conname": "pk_collections",
      "definition": "PRIMARY KEY (collection_id)"
    },
    {
      "table_name": "collections",
      "conname": "uq_collections_name",
      "definition": "UNIQUE (name)"
    },
    {
      "table_name": "document_categories",
      "conname": "fk_document_categories_category",
      "definition": "FOREIGN KEY (category_id) REFERENCES docsearch.categories(category_id) ON UPDATE RESTRICT ON DELETE CASCADE"
    },
    {
      "table_name": "document_categories",
      "conname": "fk_document_categories_document",
      "definition": "FOREIGN KEY (document_id) REFERENCES docsearch.documents(document_id) ON UPDATE RESTRICT ON DELETE CASCADE"
    },
    {
      "table_name": "document_categories",
      "conname": "pk_document_categories",
      "definition": "PRIMARY KEY (document_id, category_id)"
    },
    {
      "table_name": "document_chunks",
      "conname": "ck_document_chunks_content",
      "definition": "CHECK ((btrim(content) <> ''::text))"
    },
    {
      "table_name": "document_chunks",
      "conname": "ck_document_chunks_length",
      "definition": "CHECK ((char_length(content) = (end_offset - start_offset)))"
    },
    {
      "table_name": "document_chunks",
      "conname": "ck_document_chunks_number",
      "definition": "CHECK ((chunk_number > 0))"
    },
    {
      "table_name": "document_chunks",
      "conname": "ck_document_chunks_offsets",
      "definition": "CHECK (((start_offset >= 0) AND (end_offset > start_offset)))"
    },
    {
      "table_name": "document_chunks",
      "conname": "ck_document_chunks_page",
      "definition": "CHECK (((page_number IS NULL) OR (page_number > 0)))"
    },
    {
      "table_name": "document_chunks",
      "conname": "fk_document_chunks_document",
      "definition": "FOREIGN KEY (document_id) REFERENCES docsearch.documents(document_id) ON UPDATE RESTRICT ON DELETE CASCADE"
    },
    {
      "table_name": "document_chunks",
      "conname": "pk_document_chunks",
      "definition": "PRIMARY KEY (chunk_id)"
    },
    {
      "table_name": "document_chunks",
      "conname": "uq_document_chunks_number",
      "definition": "UNIQUE (document_id, chunk_number)"
    },
    {
      "table_name": "documents",
      "conname": "ck_documents_error",
      "definition": "CHECK (((((processing_status)::text = 'error'::text) AND (error_message IS NOT NULL) AND (btrim(error_message) <> ''::text)) OR (((processing_status)::text <> 'error'::text) AND (error_message IS NULL))))"
    },
    {
      "table_name": "documents",
      "conname": "ck_documents_filename",
      "definition": "CHECK ((btrim((original_filename)::text) <> ''::text))"
    },
    {
      "table_name": "documents",
      "conname": "ck_documents_format",
      "definition": "CHECK (((file_format)::text = ANY ((ARRAY['txt'::character varying, 'docx'::character varying, 'pdf'::character varying])::text[])))"
    },
    {
      "table_name": "documents",
      "conname": "ck_documents_ready_text",
      "definition": "CHECK ((((processing_status)::text <> 'ready'::text) OR ((extracted_text IS NOT NULL) AND (btrim(extracted_text) <> ''::text))))"
    },
    {
      "table_name": "documents",
      "conname": "ck_documents_status",
      "definition": "CHECK (((processing_status)::text = ANY ((ARRAY['pending'::character varying, 'processing'::character varying, 'ready'::character varying, 'error'::character varying])::text[])))"
    },
    {
      "table_name": "documents",
      "conname": "ck_documents_storage_key",
      "definition": "CHECK ((btrim(storage_key) <> ''::text))"
    },
    {
      "table_name": "documents",
      "conname": "ck_documents_title",
      "definition": "CHECK ((btrim((title)::text) <> ''::text))"
    },
    {
      "table_name": "documents",
      "conname": "fk_documents_collection",
      "definition": "FOREIGN KEY (collection_id) REFERENCES docsearch.collections(collection_id) ON UPDATE RESTRICT ON DELETE RESTRICT"
    },
    {
      "table_name": "documents",
      "conname": "fk_documents_uploaded_by",
      "definition": "FOREIGN KEY (uploaded_by) REFERENCES docsearch.users(user_id) ON UPDATE RESTRICT ON DELETE RESTRICT"
    },
    {
      "table_name": "documents",
      "conname": "pk_documents",
      "definition": "PRIMARY KEY (document_id)"
    },
    {
      "table_name": "documents",
      "conname": "uq_documents_storage_key",
      "definition": "UNIQUE (storage_key)"
    },
    {
      "table_name": "embedding_models",
      "conname": "ck_embedding_models_config",
      "definition": "CHECK ((jsonb_typeof(encoding_config) = 'object'::text))"
    },
    {
      "table_name": "embedding_models",
      "conname": "ck_embedding_models_dimension",
      "definition": "CHECK (((dimension >= 1) AND (dimension <= 16000)))"
    },
    {
      "table_name": "embedding_models",
      "conname": "ck_embedding_models_name",
      "definition": "CHECK ((btrim(model_name) <> ''::text))"
    },
    {
      "table_name": "embedding_models",
      "conname": "ck_embedding_models_profile",
      "definition": "CHECK ((btrim((profile_name)::text) <> ''::text))"
    },
    {
      "table_name": "embedding_models",
      "conname": "ck_embedding_models_revision",
      "definition": "CHECK ((btrim(model_revision) <> ''::text))"
    },
    {
      "table_name": "embedding_models",
      "conname": "pk_embedding_models",
      "definition": "PRIMARY KEY (model_id)"
    },
    {
      "table_name": "embedding_models",
      "conname": "uq_embedding_models_profile",
      "definition": "UNIQUE (profile_name)"
    },
    {
      "table_name": "roles",
      "conname": "ck_roles_code",
      "definition": "CHECK (((code)::text ~ '^[a-z][a-z0-9_]*$'::text))"
    },
    {
      "table_name": "roles",
      "conname": "ck_roles_name",
      "definition": "CHECK ((btrim((name)::text) <> ''::text))"
    },
    {
      "table_name": "roles",
